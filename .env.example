# ===== API KEYS =====
# Steam Store API (gratuita, sin API key requerida)
# No requiere configuración

# RAWG API (gratuita, requiere registro)
# Obtén tu API key en: https://rawg.io/apidocs
# Límites: 20,000 requests/mes, 5 requests/segundo
RAWG_API_KEY=your_rawg_api_key_here

# IGDB API (gratuita, requiere registro en Twitch)
# Obtén tus credenciales en: https://dev.twitch.tv/console/apps
# Límites: 4 requests/segundo
IGDB_CLIENT_ID=your_igdb_client_id_here
IGDB_ACCESS_TOKEN=your_igdb_access_token_here

# DeepL API (para traducción de alta calidad)
# Obtener en: https://www.deepl.com/pro-api
DEEPL_API_KEY=your_deepl_api_key_here
DEEPL_IS_PRO=false  # true para cuenta Pro, false para cuenta Free
DEEPL_REQUESTS_PER_SECOND=5  # Límite de peticiones por segundo

# Google Translate API (Google Cloud Translation)
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here
GOOGLE_TRANSLATE_REQUESTS_PER_SECOND=10  # Límite de peticiones por segundo

# APIs Configuration
STEAM_API_KEY=your_steam_api_key_here
IGDB_CLIENT_ID=your_igdb_client_id_here
IGDB_CLIENT_SECRET=your_igdb_client_secret_here
DEEPL_API_KEY=your_deepl_api_key_here
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL_HOURS=24
CACHE_MAX_SIZE=1000

# Translation Configuration
DEFAULT_SOURCE_LANGUAGE=en
DEFAULT_TARGET_LANGUAGE=es
TRANSLATION_PROVIDER=deepl
FALLBACK_TRANSLATION_PROVIDER=google

# Rate Limiting
RATE_LIMIT_ENABLED=true

# API Rate Limits (requests per time window)
STEAM_RATE_LIMIT=200          # per 5 minutes (~200 requests/5min por IP)
RAWG_RATE_LIMIT=27            # per hour (20,000/month distribuido uniformemente)
IGDB_RATE_LIMIT=4             # per second (4 requests/segundo)
DEEPL_RATE_LIMIT=20           # per minute
GOOGLE_RATE_LIMIT=100         # per minute

# Character Limits for Translation APIs
DEEPL_CHARACTER_LIMIT=694     # per minute (500k/month distribuido)
GOOGLE_CHARACTER_LIMIT=10000  # per minute (configurable según tu plan)

# Logging
LOG_LEVEL=INFO
LOG_FILE=game_translator.log